{
  "name": "coal-ui",
  "version": "0.5.0",
  "description": "Coal \u2014 independent React components and documentation",
  "license": "MIT",
  "homepage": "https://ui.chlohal.com",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run package:build && npm run examples:build && npm run smoke:build && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern node_modules",
    "registry:build": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/package.test.mjs tests/consumer.test.mjs",
    "examples:build": "node scripts/build-examples.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write app components packages/react/src lib scripts tests playwright.config.ts",
    "package:build": "node scripts/build-package.mjs",
    "smoke:build": "node scripts/build-smoke.mjs"
  },
  "dependencies": {
    "@chlohal/coal-ui": "file:packages/react",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.25",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "private": true
}
